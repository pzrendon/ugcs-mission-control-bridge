# ============================
# Node.js backend configuration
# ============================

# Port where the Node.js backend (and browser UI) will run.
NODE_PORT=3000

# Cesium Ion default access token (optional; served to the map page via GET /ugcs/cesium-token only).
CESIUM_ION_TOKEN=

# URL where Node can reach the Java bridge service.
JAVA_BRIDGE_URL=http://127.0.0.1:8090

# UgCS proxy (used by /ugcs/* routes and public/ugcs-map.html).
# When true, /ugcs/* is served by the built-in mock server instead of real UgCS.
MOCK_MODE=true
# When true, connect directly to drone via MAVLink serial (no UgCS/Java bridge). If serial port cannot be opened, falls back to mock.
MAVLINK_MODE=false
# Serial port for MAVLink (e.g. COM3 on Windows, /dev/ttyUSB0 on Linux). Used when MAVLINK_MODE=true.
MAVLINK_PORT=COM3
# Baud rate for MAVLink serial connection.
MAVLINK_BAUD=57600
# When MOCK_MODE=false and MAVLINK_MODE=false, proxy targets this host (default localhost:3334).
UGCS_PROXY_TARGET=localhost:3334

# LAANC / AirMap USS (optional). When MOCK_MODE=true, LAANC endpoints use mock responses (no AirMap calls).
# OAuth2 client credentials (preferred for api.airmap.com flight + airspace APIs):
AIRMAP_CLIENT_ID=
AIRMAP_CLIENT_SECRET=
# Optional static bearer if your AirMap project uses API key instead of OAuth:
AIRMAP_API_KEY=
LAANC_USS=airmap
# Legacy / alternate bearer (used if OAuth is not configured):
LAANC_USS_API_KEY=

# ============================
# Java bridge configuration
# ============================

# Port where the Java bridge REST API will run.
UGCS_BRIDGE_PORT=8090

# UgCS server host and port (your local GCS is typically 3334).
UGCS_HOST=127.0.0.1
UGCS_PORT=3334

# UgCS user credentials used by the Java SDK login.
# IMPORTANT: Replace with your real UgCS username/password.
UGCS_LOGIN=
UGCS_PASSWORD=
